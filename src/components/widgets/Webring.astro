---
// Components
import { Webring } from "../../components/widgets/react/Webring";

let webringData = { prev: null, next: null };

const SLUG = process.env.WEBRING_SLUG || "glutesha";
const BASE_URL = process.env.WEBRING_BASE_URL || "https://webring.otomir23.me/";

try {
    const res = await fetch(BASE_URL + SLUG + "/data");
    webringData = await res.json();
} catch (e) {
    console.error(e);
}
---

<Webring client:load prev={webringData.prev} next={webringData.next} />
